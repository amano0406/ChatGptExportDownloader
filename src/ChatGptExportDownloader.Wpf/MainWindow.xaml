<Window x:Class="ChatGptExportDownloader.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGPT Export Downloader"
        Width="1160"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#C7CED8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderBrush" Value="#D5DAE2" />
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#4D5968" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="ChatGPT Export Downloader" FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" />
                <TextBlock Text="Chrome DevTools の Copy as cURL(cmd) を貼り付けて、接続確認後に大きなZIPを分割保存します。" Foreground="#526070" Margin="0,4,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#E8EEF7" BorderBrush="#C8D6EA" BorderThickness="1" CornerRadius="4" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="状態: " Foreground="#445064" />
                    <TextBlock x:Name="StatusText" Text="未解析" FontWeight="SemiBold" Foreground="#1E3A8A" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="入力">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Chrome DevTools の cURL(cmd) としてコピーした内容" Style="{StaticResource LabelText}" />
                    <TextBox x:Name="CurlTextBox"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="NoWrap" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,10">
                        <Button Content="クリップボードから貼り付け" Click="PasteFromClipboard_Click" />
                        <Button Content="解析" Click="Analyze_Click" />
                        <Button Content="認証情報を消去" Click="ClearSecrets_Click" />
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="UrlStatusText" Grid.Row="0" Grid.Column="1" Text="未検出" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cookie" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="CookieStatusText" Grid.Row="1" Grid.Column="1" Text="未検出" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="User-Agent" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="UserAgentStatusText" Grid.Row="2" Grid.Column="1" Text="未検出" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="ファイル名" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="FileNameText" Grid.Row="3" Grid.Column="1" Text="-" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="URL(マスク)" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="RedactedUrlText" Grid.Row="4" Grid.Column="1" Text="-" Style="{StaticResource ValueText}" />
                    </Grid>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Column="2">
                <GroupBox Header="接続確認と保存先">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="保存先" Style="{StaticResource LabelText}" />
                        <Grid Grid.Row="0" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputDirectoryTextBox" Grid.Column="0" MinHeight="28" />
                            <Button Grid.Column="1" Content="選択" Margin="8,0,0,0" Click="BrowseOutputDirectory_Click" />
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="出力名" Style="{StaticResource LabelText}" />
                        <TextBox x:Name="OutputFileNameTextBox" Grid.Row="1" Grid.Column="1" MinHeight="28" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="分割サイズ" Style="{StaticResource LabelText}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox x:Name="ChunkMiBTextBox" Text="128" Width="70" MinHeight="28" />
                            <TextBlock Text=" MiB  通常はこのままでOK" VerticalAlignment="Center" Foreground="#4D5968" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,10">
                            <Button Content="接続確認（サイズ確認）" Click="Probe_Click" />
                            <Button Content="ダウンロード開始" Click="Download_Click" />
                            <Button Content="停止" Click="Cancel_Click" />
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="HTTP" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="HttpStatusText" Grid.Row="4" Grid.Column="1" Text="-" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="分割取得" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="RangeStatusText" Grid.Row="5" Grid.Column="1" Text="-" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="総サイズ" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="TotalSizeText" Grid.Row="6" Grid.Column="1" Text="-" Style="{StaticResource ValueText}" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="ETag / 更新" Style="{StaticResource LabelText}" />
                        <TextBlock x:Name="MetadataText" Grid.Row="7" Grid.Column="1" Text="-" Style="{StaticResource ValueText}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="進捗">
                    <StackPanel>
                        <ProgressBar x:Name="DownloadProgressBar" Height="22" Minimum="0" Maximum="100" />
                        <TextBlock x:Name="ProgressText" Text="未開始" Margin="0,8,0,0" Style="{StaticResource ValueText}" />
                        <TextBlock x:Name="SpeedText" Text="-" Margin="0,4,0,0" Foreground="#4D5968" />
                        <TextBlock x:Name="CurrentRangeText" Text="-" Margin="0,4,0,0" Foreground="#4D5968" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="ログ">
                    <TextBox x:Name="LogTextBox"
                             Height="210"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap" />
                </GroupBox>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="Cookie や署名付きURLはログに出しません。貼り付け欄の内容は、認証情報を消去ボタンで破棄できます。"
                   Foreground="#697586"
                   Margin="0,10,0,0" />
    </Grid>
</Window>
